<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 外层包裹 FrameLayout 内部才能够设置 Margin -->
    <LinearLayout
        android:id="@+id/inputDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="48dp"
        android:background="#ffffffff"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inputDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="title"
            android:textColor="#ff666666"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/inputDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:paddingHorizontal="24dp"
            android:paddingBottom="8dp"
            android:textColor="#ff666666"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inputDialogEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="4dp"
            android:hint="please enter content."
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="14dp"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inputDialogCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:text="cancel"
                android:textAlignment="center"
                android:textColor="#ff666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/inputDialogConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:text="confirm"
                android:textAlignment="center"
                android:textColor="#FFEDA664"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
